# Plantilla de variables de entorno del proyecto.
# Este archivo permanece en el repositorio; el .env con los valores reales no.

# Clave del usuario sa de SQL Server.
# Minimo 8 caracteres: mayusculas, minusculas, digitos y simbolos.
MSSQL_SA_PASSWORD=CAMBIAR_ESTA_CLAVE_SECRETA

# Cuenta de Docker Hub que se usa como prefijo de las imagenes.
DOCKERHUB_USER=usuario

# SECRET_KEY de Django.
DJANGO_SECRET_KEY=CAMBIAR_ESTA_CLAVE_SECRETA
